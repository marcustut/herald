# Copy to .env (gitignored, never commit it) and fill in real values:
#   cp .env.example .env
#
# The database URL must use the "postgres" Compose service name as the host and
# match HERALD_POSTGRES_PASSWORD. sslmode=disable is safe here because the
# connection stays on the Compose network.

HERALD_DATABASE_URL=postgres://herald:change-me@postgres:5432/herald?sslmode=disable

HERALD_POSTGRES_USER=herald
HERALD_POSTGRES_PASSWORD=change-me
HERALD_POSTGRES_DB=herald

# SMTP submission credentials for the email sink. Leave blank to configure only
# webhook sinks.
HERALD_SMTP_USERNAME=
HERALD_SMTP_PASSWORD=

# Optional knobs.
HERALD_PORT=8787
HERALD_DISPATCH_WORKERS=2
